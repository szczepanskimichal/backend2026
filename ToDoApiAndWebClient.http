@baseUrl = http://localhost:5001
### Hent alle todos

GET {{baseUrl}}/todos
Accept: application/json

### Hent todo 1

GET {{baseUrl}}/todos/1
Accept: application/json

### Opprett en todo

POST {{baseUrl}}/todos
Content-Type: application/json
    
{
    "text": "Ny todo3"
}

### Oppdater en todo

PUT {{baseUrl}}/todos/2
Content-Type: application/json

{
    "text": "Oppdatert todoTest2",
    "isDone": true
}
### Patch en todo

PATCH {{baseUrl}}/todos/1
Content-Type: application/json

{
    "text": "Oppdatert todo",
    "isDone": true
}

### Slett en todo

DELETE {{baseUrl}}/todos/1
